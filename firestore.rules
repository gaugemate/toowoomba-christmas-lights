rules_version = '2';
// Database rules for Toowoomba Christmas Lights (Firebase Firestore).
// - Anyone can see approved displays.
// - Anyone can add a display, but only as "pending", and only with the expected fields and sizes.
// - Each phone gets a private anonymous ID; a display added from that phone carries it as ownerUid,
//   so that phone (and nobody else) can see, edit or remove it.
// - When the person who added it edits an approved display: changes to the size, features, how to see it,
//   dates and hours stay on the map; changing the address, suburb, map spot or notes sends it back to "pending".
// - Only admins can see everyone's pending displays, approve them, or change or delete any display.
// - A display can have a photo: a small preview ("thumb") in the display itself, and the full photo in
//   photos/<display ID>. A photo is only public once its display is approved, and the person who added the
//   display can only put up a new photo while it's waiting for a check (so every photo is checked).
// - The person who added a display can switch it off for one night ("offDate" = that night's date, e.g. for
//   bad weather) without it going back for a check. It turns itself back on the next day.
// - "Start a new year" (admins only) copies every display into archive/<year> before clearing the map.
// - Admins are listed in the "admins" collection: one document per admin, named with their user ID
//   (shown on the app's #admin page after they sign in). Add those by hand in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(d) {
      // (a display added before ownerUid existed has none, so this check simply fails for it)
      return request.auth != null && d.ownerUid == request.auth.uid;
    }

    function str(v, max) { return v is string && v.size() <= max; }

    // The details a display can have, whoever is writing them
    function goodDetails(d) {
      return str(d.address, 120) && d.address.size() > 0
        && (!('suburb' in d) || str(d.suburb, 60))
        && d.lat is number && d.lat > -28.5 && d.lat < -26.5
        && d.lng is number && d.lng > 150.5 && d.lng < 153
        && d.size is int && d.size >= 1 && d.size <= 4
        && d.viewing in ['drive', 'walk']
        && (!('features' in d) || (d.features is list && d.features.size() <= 10))
        && (!('from' in d) || str(d.from, 10))
        && (!('until' in d) || str(d.until, 10))
        && (!('hours' in d) || str(d.hours, 30))
        && (!('notes' in d) || str(d.notes, 200))
        && (!('offDate' in d) || str(d.offDate, 10))
        && (!('thumb' in d) || (str(d.thumb, 12000) && (d.thumb == '' || d.thumb.matches('data:image/jpeg;base64,.*'))));
    }

    function validNewDisplay(d) {
      return d.keys().hasOnly(['address', 'suburb', 'lat', 'lng', 'size', 'features', 'viewing',
                               'from', 'until', 'hours', 'notes', 'thumb', 'status', 'createdAt', 'ownerUid'])
        && d.keys().hasAll(['address', 'lat', 'lng', 'size', 'viewing', 'status', 'createdAt'])
        && d.status == 'pending'
        && d.createdAt == request.time
        && (!('ownerUid' in d) || (request.auth != null && d.ownerUid == request.auth.uid))
        && goodDetails(d);
    }

    // The person who added a display editing it
    function ownerEdit() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return isOwner(before)
        && after.ownerUid == before.ownerUid
        && goodDetails(after)
        && changed.hasOnly(['address', 'suburb', 'lat', 'lng', 'size', 'features', 'viewing',
                            'from', 'until', 'hours', 'notes', 'thumb', 'offDate', 'status', 'updatedAt'])
        && (after.status == 'pending'
            || (before.status == 'approved' && after.status == 'approved'
                && changed.hasOnly(['size', 'features', 'viewing', 'from', 'until', 'hours', 'thumb', 'offDate', 'updatedAt'])
                && (!changed.hasAny(['thumb']) || after.thumb == '')));   // taking a photo off needs no re-check
    }

    match /displays/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin() || isOwner(resource.data);
      allow create: if validNewDisplay(request.resource.data);
      allow update: if isAdmin() || ownerEdit();
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    // The full-size photo of a display (document ID = the display's ID)
    match /photos/{id} {
      function display() { return get(/databases/$(database)/documents/displays/$(id)).data; }
      function goodPhoto(p) {
        return p.keys().hasOnly(['image', 'ownerUid', 'updatedAt'])
          && p.image is string && p.image.size() <= 350000 && p.image.matches('data:image/jpeg;base64,.*')
          && p.updatedAt == request.time;
      }
      allow read: if isAdmin()
        || (exists(/databases/$(database)/documents/displays/$(id)) && display().status == 'approved')
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create, update: if request.auth != null && goodPhoto(request.resource.data)
        && (isAdmin()
            || (request.resource.data.ownerUid == request.auth.uid
                && display().ownerUid == request.auth.uid && display().status == 'pending'));
      allow delete: if isAdmin() || (request.auth != null && resource.data.ownerUid == request.auth.uid);
    }

    // Last year's displays, copied here by "Start a new year" before the map is cleared. Admins only.
    match /archive/{rest=**} {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      // An admin check reads your own entry; nobody can add themselves from the app
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
